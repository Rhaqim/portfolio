---
// loom was renamed Noewright. Old invite links look like /demo/loom?game=CODE,
// and Astro's built-in redirects drop the query string, so forward it here.
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>Noewright demo</title>
		<meta name="robots" content="noindex" />
		<link rel="canonical" href="https://rhaqim.com/demo/noewright" />
		<script is:inline>location.replace("/demo/noewright" + location.search + location.hash);</script>
		<noscript><meta http-equiv="refresh" content="0;url=/demo/noewright" /></noscript>
	</head>
	<body>
		<a href="/demo/noewright">Continue to the Noewright demo</a>
	</body>
</html>
