---
import { site, links } from "@data/site";

const year = new Date().getFullYear();

const contact = [
	{ label: "Email", href: links.email },
	{ label: "GitHub", href: links.github },
	{ label: "LinkedIn", href: links.linkedin },
	{ label: "X", href: links.twitter },
];
---

<footer class="ftr" id="contact">
	<div class="wrap ftr-inner">
		<div class="ftr-lead">
			<p class="ftr-cta">Open to systems and infrastructure work.</p>
			<a class="ftr-email" href={links.email}>{site.email}</a>
		</div>

		<nav class="ftr-links" aria-label="Contact">
			{
				contact.map((c) => (
					<a
						class="ftr-link"
						href={c.href}
						target={c.href.startsWith("mailto:") ? undefined : "_blank"}
						rel={c.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
					>
						{c.label}
					</a>
				))
			}
		</nav>
	</div>

	<div class="wrap ftr-base">
		<span class="mono ftr-meta">{site.legalName}</span>
		<span class="mono ftr-meta">© {year}</span>
	</div>
</footer>

<style>
	.ftr {
		border-top: 1px solid var(--line);
		background: var(--bg-sunken);
	}

	.ftr-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 32px;
		padding-block: clamp(48px, 7vw, 88px);
	}

	.ftr-cta {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--fg-dim);
		margin-bottom: 14px;
	}

	.ftr-email {
		font-size: clamp(1.5rem, 4.5vw, 2.5rem);
		font-weight: 500;
		letter-spacing: -0.025em;
		color: var(--fg);
		border-bottom: 1px solid var(--line-strong);
		padding-bottom: 4px;
		transition:
			color 0.18s ease,
			border-color 0.18s ease;
	}

	.ftr-email:hover {
		color: var(--red-bright);
		border-color: var(--red);
	}

	.ftr-links {
		display: flex;
		flex-wrap: wrap;
		gap: 20px;
	}

	.ftr-link {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		color: var(--fg-dim);
		transition: color 0.18s ease;
	}

	.ftr-link:hover {
		color: var(--red-bright);
	}

	.ftr-base {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		padding-block: 16px;
		border-top: 1px solid var(--line);
	}

	.ftr-meta {
		font-size: 0.6875rem;
		letter-spacing: 0.08em;
		color: var(--fg-faint);
	}
</style>
