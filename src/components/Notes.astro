---
import { notes } from "@data/notes";
---

<section class="section notes" id="notes" aria-labelledby="notes-title" data-cloud="link" data-cloud-size="0.6">
	<div class="wrap">
		<div class="section-head">
			<span class="section-index">05</span>
			<h2 class="section-title" id="notes-title">Notes</h2>
		</div>

		<ul class="note-list">
			{
				notes.map((n) => (
					<li data-reveal>
						<a class="note-row" href={`/notes/${n.slug}`}>
							<span class="note-date mono">{n.date}</span>
							<span class="note-main">
								<span class="note-name">{n.title}</span>
								<span class="note-sum">{n.summary}</span>
							</span>
							<span class="note-go mono" aria-hidden="true">→</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.note-list {
		list-style: none;
		border-top: 1px solid var(--line);
	}

	.note-row {
		display: grid;
		grid-template-columns: 90px minmax(0, 1fr) auto;
		gap: 20px;
		align-items: baseline;
		padding: 22px 0;
		border-bottom: 1px solid var(--line);
	}

	.note-date {
		font-size: 0.75rem;
		color: var(--fg-faint);
	}

	.note-main {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.note-name {
		font-size: 1.125rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		color: var(--fg);
		transition: color 0.18s ease;
	}

	.note-sum {
		color: var(--fg-mid);
		font-size: 0.9375rem;
		line-height: 1.6;
		max-width: 70ch;
	}

	.note-go {
		color: var(--fg-dim);
		transition: transform 0.18s ease, color 0.18s ease;
	}

	.note-row:hover .note-name {
		color: var(--red-bright);
	}

	.note-row:hover .note-go {
		color: var(--red-bright);
		transform: translateX(3px);
	}

	@media (max-width: 640px) {
		.note-row {
			grid-template-columns: minmax(0, 1fr) auto;
		}

		.note-date {
			grid-column: 1 / -1;
		}
	}
</style>
